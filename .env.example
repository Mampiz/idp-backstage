# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# Every service reads its secrets from the environment only.

# GitHub PAT used by the Go scaffolder service (F3) and by Backstage GitHub
# discovery / RepoUrlPicker (F1, F4).
# Scopes needed: repo, workflow, read:org
GITHUB_TOKEN=

# GitHub org/user under which scaffolded repos are created.
GITHUB_OWNER=Mampiz

# Postgres for Backstage (F1) - consumed by docker-compose and app-config.
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
