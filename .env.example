# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# Every service reads its secrets from the environment only.

# GITHUB_TOKEN is deliberately NOT listed as a key here. It never goes on disk,
# not even in the gitignored .env: export it in your shell before running
# anything that talks to GitHub (Backstage integrations, the Go scaffolder).
#
#   export GITHUB_TOKEN=$(gh auth token)
#
# The "workflow" scope is REQUIRED, not optional: the scaffolded repository
# contains .github/workflows/ci.yml, and GitHub refuses to write anything under
# .github/workflows/ without it — reporting a bare 404 that looks like a missing
# repository. The gh CLI does not request that scope by default:
#
#   gh auth refresh -h github.com -s workflow
#
# A classic PAT works too, with: repo, workflow, read:org
#
# Everything below is non-secret local configuration and is safe to keep here.

# GitHub org/user under which scaffolded repos are created.
GITHUB_OWNER=Mampiz

# Postgres for Backstage (F1) - consumed by docker-compose and app-config.
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Static token that the local phase verifiers use to call the Backstage backend
# APIs without a browser session. Generate one with:
#   node -p "require('crypto').randomBytes(24).toString('base64')"
BACKSTAGE_VERIFY_TOKEN=

# Where Backstage's proxy finds the Go status API (NodePort mapped by kind).
STATUS_API_URL=http://localhost:30081
