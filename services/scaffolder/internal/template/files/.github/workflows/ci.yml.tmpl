name: ci

on:
  push:
    branches: [{{ .DefaultBranch }}]
  pull_request:

permissions:
  contents: read
  packages: write

env:
  IMAGE: ghcr.io/${{ "{{" }} github.repository {{ "}}" }}

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-go@v7
        with:
          go-version-file: go.mod
      - run: go vet ./...
      - run: go test -race ./...

  image:
    # Only publish from the default branch: pull requests build nothing that
    # anyone could pull by accident.
    if: github.event_name == 'push'
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ "{{" }} github.actor {{ "}}" }}
          password: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}

      - name: Tags
        id: tags
        run: |
          # The operator's admission webhook rejects :latest and untagged
          # images, so every tag published here is an explicit immutable one.
          echo "sha=${IMAGE}:${GITHUB_SHA::12}" >> "$GITHUB_OUTPUT"

      - uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ "{{" }} steps.tags.outputs.sha {{ "}}" }}
